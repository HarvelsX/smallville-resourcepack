          "model": "smallville:item/cards/ace_diamonds"
        }
      },
      {
        "when": "smallville:ace_hearts",
        "model": {
          "type": "minecraft:model",
          "model": "smallville:item/cards/ace_hearts"
        }
      },
      {
        "when": "smallville:ace_spades",
        "model": {
          "type": "minecraft:model",
          "model": "smallville:item/cards/ace_spades"
        }
      },
      {
        "when": "smallville:jokerge",
